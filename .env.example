# Copy this file to .env and replace the placeholder values.
# Never commit real credentials.

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

KUN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/touchgal
KUN_VISUAL_NOVEL_SITE_URL=https://example.com
NEXT_PUBLIC_KUN_PATCH_ADDRESS_DEV=http://127.0.0.1:3000
NEXT_PUBLIC_KUN_PATCH_ADDRESS_PROD=https://example.com
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
DLSITE_API_URL=http://127.0.0.1:8000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ISS=touchgal
JWT_AUD=touchgal_admin
JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer
SMTP_PASS=replace-me
SMTP_FROM_EMAIL=mail@example.com
SMTP_FROM_NAME=TouchGal

AWS_SES_REGION=ap-northeast-3
AWS_SES_ACCESS_KEY_ID=replace-me
AWS_SES_SECRET_ACCESS_KEY=replace-me
AWS_SES_FROM_EMAIL=mail@example.com
AWS_SES_FROM_NAME=TouchGal

KUN_VISUAL_NOVEL_S3_STORAGE_ACCESS_KEY_ID=replace-me
KUN_VISUAL_NOVEL_S3_STORAGE_SECRET_ACCESS_KEY=replace-me
KUN_VISUAL_NOVEL_S3_STORAGE_BUCKET_NAME=touchgal
KUN_VISUAL_NOVEL_S3_STORAGE_ENDPOINT=https://s3.example.com
KUN_VISUAL_NOVEL_S3_STORAGE_REGION=auto
KUN_VISUAL_NOVEL_S3_KEY_PREFIX=kun
KUN_S3_FORCE_PATH_STYLE=false
NEXT_PUBLIC_KUN_VISUAL_NOVEL_S3_STORAGE_URL=https://s3.example.com

KUN_VISUAL_NOVEL_IMAGE_BED_HOST=img.example.com
KUN_VISUAL_NOVEL_IMAGE_BED_URL=https://img.example.com
NEXT_PUBLIC_KUN_RANKING_IMAGE_BED_URL=https://img.example.com

KUN_CF_CACHE_ZONE_ID=replace-me
KUN_CF_CACHE_PURGE_API_TOKEN=replace-me
KUN_VISUAL_NOVEL_INDEX_NOW_KEY=replace-me

KUN_ENABLE_CRON=false
TRUST_PROXY=false
KUN_VISUAL_NOVEL_TEST_SITE_LABEL=

KUN_BACKUP_S3_ACCESS_KEY_ID=replace-me
KUN_BACKUP_S3_SECRET_ACCESS_KEY=replace-me
KUN_BACKUP_S3_BUCKET=replace-me-private-backup-bucket
KUN_BACKUP_S3_ENDPOINT=https://s3.example.com
KUN_BACKUP_S3_REGION=auto
KUN_BACKUP_S3_PREFIX=postgres
KUN_BACKUP_RETENTION_DAYS=14
KUN_BACKUP_S3_FORCE_PATH_STYLE=false
KUN_VIEWS_DIRECT_WRITE=false
PATCH_VIEW_BUFFER_ALERT_THRESHOLD=5000
PATCH_VIEW_HEALTH_TOKEN=change-me
PATCH_VIEW_HEALTH_ALLOWED_IPS=

KUN_BANGUMI_TOKEN=replace-me
PYTHON_API_SECRET=replace-me
# 普通用户 AI key 池（必须单独配置，不能和 ops 共用）
DEEPSEEK_API_KEYS_FREE=replace-me,replace-me
# 管理员 / 超管 / 支持者 / DLsite 翻译 key 池
DEEPSEEK_API_KEYS_OPS=replace-me,replace-me
# 兼容旧部署；新部署优先使用上面的分池变量
DEEPSEEK_API_KEY=replace-me
CHAT_MAX_CONCURRENT=2
