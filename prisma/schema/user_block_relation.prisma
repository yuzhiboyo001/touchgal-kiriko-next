model user_block_relation {
  id         Int      @id @default(autoincrement())
  blocker_id Int
  blocked_id Int
  created    DateTime @default(now())

  blocker user @relation("user_blocker", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked user @relation("user_blocked", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
}
