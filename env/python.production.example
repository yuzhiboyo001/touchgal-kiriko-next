# Copy this file to PythonProject17/.env.production on the production server.
# Keep PYTHON_API_SECRET identical to the Next.js value.
# Start the service with APP_ENV=production.

APP_ENV=production
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000
PYTHON_MAX_BODY_BYTES=1048576

# Shared with Next
KUN_DATABASE_URL=postgresql://kun:password@127.0.0.1:5432/kun_touchgal?schema=public
PYTHON_API_SECRET=replace-with-one-shared-random-secret

# DeepSeek
DEEPSEEK_API_KEYS=sk-first,sk-second
CHAT_MAX_CONCURRENT=15
CHAT_MAX_OUTPUT_TOKENS=800
DEEPSEEK_KEY_COOLDOWN_SECONDS=60

# Production VPS is in Tokyo: direct DLsite, no local proxy.
CRAWLER_PROXY=

# R2 cover CDN
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kiriko-images
R2_REGION=auto
R2_RANKING_PREFIX=ranking/
R2_PUBLIC_BASE=https://img.kiriko.ink

# Purchase history pool
PURCHASE_HISTORY_CACHE_SECONDS=0
PURCHASE_HISTORY_POOL_MIN=1
PURCHASE_HISTORY_POOL_MAX=5
